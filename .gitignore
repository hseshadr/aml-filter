# Tree-guard: the production Ed25519 signing seed and the CI-staged bundle output
# must NEVER be committed. The key lives only in the WATCHLIST_SIGNING_KEY GitHub
# Actions secret; only the PUBLIC verify key (frontend/app/public/public.key) is tracked.
signing.key
frontend/origin/

# Build residue from `edgeproc publish`. It writes a producer-side CAS mirror
# (chunks/, manifests/) and a .mutation.lock ALONGSIDE the served contract, which
# is only latest + manifest/<hash> + chunk/<hash>. The builders delete these
# (removeProducerResidue in buildRealBundle.ts) so the committed demo bundle and
# the deployed tree are exactly the served contract. These entries are the
# backstop for an interrupted or hand-run publish: residue must never reach a
# commit or the CDN.
.mutation.lock
frontend/app/public/bundle/origin/chunks/
frontend/app/public/bundle/origin/manifests/
frontend/app/tests/e2e-bundle/fixtures/bundle-v2/origin/chunks/
frontend/app/tests/e2e-bundle/fixtures/bundle-v2/origin/manifests/
frontend/packages/amlfilter-publisher/.bundle-staging/
frontend/packages/amlfilter-publisher/.bundle-v2-staging/

# The decision harness's emitted evidence (~12 MB of per-(query, candidate) rows).
# GENERATED, never committed: `gate:decision` emits it and scores it in ONE
# command, so the Python floors can never grade a run describing a matcher that is
# no longer in the tree — the staleness window does not exist. The reviewable
# artifact is eval/baselines/decision-baseline.json, which IS committed.
frontend/packages/amlfilter-publisher/.decision-out/

# Python (eval/) — the offline decision-metrics scorer.
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

