## AML-Filter v2 (local development)
## Copy this file to `.env` for local development:
##   cp .env.example .env

# --- App ---
ENVIRONMENT=development

# --- Backend (run on host, talks to docker services via published ports) ---
# docker-compose publishes Postgres on localhost:5435 and Valkey/Redis on localhost:6380
DATABASE_URL=postgresql+asyncpg://amlfilter:amlfilter_dev_password@127.0.0.1:5435/amlfilter
REDIS_URL=redis://127.0.0.1:6380/0

# --- Tests ---
TEST_DATABASE_URL=postgresql+asyncpg://amlfilter:amlfilter_dev_password@127.0.0.1:5435/amlfilter_test
TEST_REDIS_URL=redis://127.0.0.1:6380/0

# --- edge-proc localvec (vector retrieval substrate) ---
# Where the edge-proc localvec FAISS index is persisted (built at ingest, loaded at
# query/startup). Resolved standalone, so the vector backend never forces a DATABASE_URL.
VECTOR_INDEX_DIR=.vector_index

# --- edge-proc signed-bundle screening (no-Postgres path) ---
# Set BUNDLE_BASE_URL *and* VERIFY_KEY_PATH together to activate the bundle-backed
# read-path: screening reads OFAC candidates from a synced, ed25519-verified bundle
# instead of Postgres. Leave both unset for the default DB path.
#
# Origin serving the signed, content-addressed OFAC bundle: an http(s):// URL or local path.
BUNDLE_BASE_URL=
# Path to the pinned ed25519 PUBLIC key used to fail-closed verify a synced bundle.
VERIFY_KEY_PATH=
# Local cache root for synced bundle objects.
BUNDLE_CACHE_DIR=.ofac_bundle
