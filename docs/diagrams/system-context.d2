# aml-filter — system context (v4, zero-server)
# Publisher (CI) signs a content-addressed watchlist bundle -> browser verifies + screens in-tab

direction: right

ofac: {
  label: "OFAC SDN list\n(designated by U.S. Treasury — public domain)\npublished via the Consolidated Screening List\n(U.S. Commerce / ITA, data.trade.gov)"
  shape: document
}

publisher: {
  label: "@amlfilter/publisher\n(GitHub Action, daily)\nfetch · normalize · embed (transformers.js in Node)\nEd25519-sign"
  shape: rectangle
}

cdn: {
  label: "Static host / CDN\nsigned bundle: latest + manifest/ + chunk/\n+ the SPA"
  shape: cylinder
}

browser: {
  label: "Browser tab (the whole app)\n@amlfilter/browser — verify fail-closed · embed · cosine · score\n@amlfilter/workstation — SQLite-WASM / OPFS customers + matches"
  shape: rectangle
}

user: {
  label: "User\n(analyst — no signup, no backend)"
  shape: person
}

ofac -> publisher: "consolidated.csv (SDN rows only)"
publisher -> cdn: "signed bundle (latest + manifest + chunk)"
cdn -> browser: "fetch signed bundle + SPA (HTTPS, same-origin)"
user -> browser: "load customers · screen names"
browser -> user: "scored, explained matches + review queue"

publisher -> browser: "trust: Ed25519 signature\nverified vs pinned public.key" {
  style.stroke-dash: 4
}
