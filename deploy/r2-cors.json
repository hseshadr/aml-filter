{
  "rules": [
    {
      "allowed": {
        "origins": ["https://aml-filter.com", "https://www.aml-filter.com"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "If-None-Match", "If-Match"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Range", "Accept-Ranges"],
      "maxAgeSeconds": 86400
    }
  ]
}
