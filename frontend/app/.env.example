# aml-filter — example environment configuration for the SPA.
#
# Copy this file to `.env` in this directory and adjust as needed:
#   cp .env.example .env
# `.env` is gitignored; this `.env.example` is committed. None of these are
# required for the local demo — the committed signed demo bundle works on a cold
# clone with everything unset. All app variables are build-time Vite vars and MUST
# be prefixed `VITE_` to be exposed to the client bundle.

# Where the signed, content-addressed watchlist bundle is served from.
# Unset (default): same-origin "/bundle/origin" — how production runs. Cloudflare
# Pages serves the signed bundle same-origin (no separate host, no CORS). Set this
# ONLY to override the origin, e.g. to point the app at a separate CDN host:
# VITE_BUNDLE_BASE_URL=https://cdn.example.com

# Model-load IDLE window (ms): how long the in-tab MiniLM warmup may go with NO
# download progress before bootstrap fails loudly. It keys on silence, not wall
# time, so a slow-but-progressing download is never cut short. Unset (default):
# 90000 — MODEL_LOAD_IDLE_TIMEOUT_MS baked into the engine. Exists mainly so the
# e2e lanes can bound a blocked model to seconds; leave unset in a normal build.
# VITE_MODEL_LOAD_IDLE_TIMEOUT_MS=90000

# Last-resort ceiling (ms) on the WHOLE bootstrap (bundle sync + verify + model
# warmup) before /screen fails loudly. Unset (default): 900000 (15 minutes) — the
# production BOOT_TIMEOUT_MS baked into the engine, sized above the slowest
# healthy cold sync. Stalls are caught far sooner by the per-fetch and
# no-progress timeouts. Exists mainly to bound a cold-cache boot in e2e; leave
# unset in a normal build.
# VITE_BOOT_TIMEOUT_MS=900000

# --- Publisher (Node tool: frontend/packages/amlfilter-publisher) ---
# Not read by the SPA. Override the OFAC source base URL (the sanctions-list
# service; defaults to the current portal) or the edge-proc working directory
# used when packing a bundle. Only set if you relocate/repoint them.
# OFAC_BASE=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports
# EDGEPROC_DIR=
