# aml-filter — example environment configuration for the SPA.
#
# Copy this file to `.env` in this directory and adjust as needed:
#   cp .env.example .env
# `.env` is gitignored; this `.env.example` is committed. None of these are
# required for the local demo — the committed signed demo bundle works on a cold
# clone with everything unset. All app variables are build-time Vite vars and MUST
# be prefixed `VITE_` to be exposed to the client bundle.

# Where the signed, content-addressed watchlist bundle is served from.
# Unset (default): same-origin "/bundle/origin" — the committed demo bundle.
# In production, point at the separately-published bundle host/CDN, e.g.:
# VITE_BUNDLE_BASE_URL=https://lists.aml-filter.com

# Upper bound (ms) for the in-tab MiniLM model warmup before bootstrap fails loudly.
# Unset (default): 120000 — the production ceiling baked into the engine.
# VITE_MODEL_LOAD_TIMEOUT_MS=120000

# --- Publisher (Node tool: frontend/packages/amlfilter-publisher) ---
# Not read by the SPA. Override the edge-proc working directory used when packing
# a bundle; defaults to a sensible path. Only set if you relocate it.
# EDGEPROC_DIR=
