# --- Admin dashboard (DB-backed pages) ---
# The base URL for the AML-Filter backend API.
VITE_API_URL=http://localhost:8000

# --- In-browser screening tier (the /screen page, no backend) ---
# Origin serving the signed, content-addressed OFAC bundle published by
# `aml_filter.bundle.publish` (`/latest`, `/manifest/<hash>`, `/chunk/<hash>`).
# The ed25519 PUBLIC key is pinned separately at app/public/public.key and is
# served from the app's OWN origin — never from this (untrusted) bundle origin.
VITE_BUNDLE_BASE_URL=http://localhost:8080
