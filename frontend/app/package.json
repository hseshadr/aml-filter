{
	"name": "aml-filter-app",
	"version": "2.1.0",
	"description": "AML-Filter v2 frontend — admin dashboard + in-browser OFAC screening.",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite",
		"download-model": "node scripts/download-model.mjs",
		"gen:stats": "node scripts/gen-demo-stats.mjs",
		"prebuild": "node scripts/download-model.mjs && node scripts/gen-demo-stats.mjs",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"pretest": "node scripts/gen-demo-stats.mjs",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:c1": "playwright test -c playwright.c1.config.ts",
		"test:e2e:kyc": "playwright test -c playwright.kyc.config.ts",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report"
	},
	"dependencies": {
		"@amlfilter/browser": "workspace:*",
		"@amlfilter/workstation": "workspace:*",
		"@hpcc-js/wasm-zstd": "^1.12.6",
		"@huggingface/transformers": "^4.2.0",
		"@noble/ed25519": "^3.1.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router-dom": "^7.18.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@playwright/test": "^1.57.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.1.0",
		"@types/node": "^22.10.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"jsdom": "^29.1.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.9"
	}
}
