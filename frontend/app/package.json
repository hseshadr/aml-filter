{
	"name": "aml-filter-app",
	"version": "4.0.0",
	"description": "AML-Filter v4 — zero-server React app: in-browser OFAC screening + local-first KYC workstation, no backend.",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite",
		"download-model": "node scripts/download-model.mjs",
		"gen:stats": "node scripts/gen-demo-stats.mjs",
		"prebuild": "node scripts/download-model.mjs && node scripts/gen-demo-stats.mjs && node scripts/stage-ort-wasm.mjs",
		"build": "tsc --noEmit && vite build",
		"test:contract": "node --test scripts/canonical-worker.test.mjs",
		"preview": "vite preview",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"pretest": "node scripts/gen-demo-stats.mjs",
		"test": "vitest run",
		"pretest:coverage": "node scripts/gen-demo-stats.mjs",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:c1": "playwright test -c playwright.c1.config.ts",
		"test:e2e:kyc": "playwright test -c playwright.kyc.config.ts",
		"test:e2e:bundle": "playwright test -c playwright.bundle.config.ts",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report",
		"verify:i18n": "node scripts/verify-i18n.mjs"
	},
	"dependencies": {
		"@amlfilter/browser": "workspace:*",
		"@amlfilter/workstation": "workspace:*",
		"@edgeproc/errors": "workspace:*",
		"@hpcc-js/wasm-zstd": "^1.13.4",
		"@huggingface/transformers": "^4.2.0",
		"@noble/ed25519": "^3.1.0",
		"i18next": "^26.3.1",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-i18next": "^17.0.8",
		"react-router-dom": "^7.18.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@playwright/test": "^1.61.1",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.1.0",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/coverage-v8": "^4.1.10",
		"jsdom": "^29.1.1",
		"typescript": "^7.0.2",
		"vite": "^8.1.4",
		"vitest": "^4.1.10"
	}
}
