{
	"name": "@amlfilter/publisher",
	"private": true,
	"version": "3.0.0",
	"license": "MIT",
	"type": "module",
	"description": "Node-side signed-watchlist publisher: maps OFAC entities, precomputes name vectors (transformers.js), and emits the signed v3 wire artifact the browser tier syncs.",
	"exports": {
		".": "./src/index.ts"
	},
	"bin": {
		"amlfilter-publish": "./src/cli.ts"
	},
	"scripts": {
		"lint": "biome check .",
		"typecheck": "tsc -b",
		"test": "vitest run",
		"publish": "vite-node src/cli.ts --",
		"build-demo": "vite-node src/buildDemo.ts",
		"build-demo-v2": "vite-node src/buildDemoV2.ts",
		"build-demo-multilist": "vite-node src/buildDemoMultiList.ts",
		"build-demo-catalog-v2": "vite-node src/buildDemoCatalogV2.ts"
	},
	"dependencies": {
		"@amlfilter/browser": "workspace:*",
		"@huggingface/transformers": "^4.2.0",
		"@noble/ed25519": "^3.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/node": "^22.10.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-node": "^6.0.0",
		"vitest": "^4.1.9"
	}
}
