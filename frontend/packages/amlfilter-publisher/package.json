{
	"name": "@amlfilter/publisher",
	"private": true,
	"version": "4.0.0",
	"license": "MIT",
	"type": "module",
	"description": "Node-side OFAC/EU/UN/UK publisher: validates required feeds, precomputes name vectors, and emits the signed content-addressed bundle the browser delta-syncs.",
	"exports": {
		".": "./src/index.ts"
	},
	"bin": {
		"amlfilter-publish": "./src/cli.ts"
	},
	"scripts": {
		"lint": "biome check .",
		"typecheck": "tsc -b",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"publish": "vite-node src/cli.ts --",
		"build-real-bundle": "vite-node src/buildRealBundleMain.ts --",
		"build-demo-bundle": "vite-node src/buildDemoBundle.ts",
		"build-demo-bundle-v2": "vite-node src/buildDemoBundleV2.ts",
		"next-published-sequence": "vite-node src/nextPublishedSequenceMain.ts --",
		"verify-published-origin": "vite-node src/verifyPublishedOriginMain.ts --",
		"mirror-published-origin": "vite-node src/mirrorPublishedOriginMain.ts --",
		"check-published-freshness": "vite-node src/checkPublishedFreshnessMain.ts --"
	},
	"dependencies": {
		"@amlfilter/browser": "workspace:*",
		"@huggingface/transformers": "^4.2.0",
		"@noble/ed25519": "^3.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/node": "^26.1.2",
		"@vitest/coverage-v8": "^4.1.10",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vite-node": "^6.0.0",
		"vitest": "^4.1.10"
	}
}
